<?xml version="1.0"?>
<package format="3">
  <name>explorer</name>
  <version>0.0.0</version>
  <description>Frontier-based autonomous exploration: sends the planner to the edge of the known map until the whole reachable area is mapped</description>

  <maintainer email="sulaimanqazi14@gmail.com">Sulaiman Qazi</maintainer>
  <license>Apache2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
